{
  "name": "flight_search_demo",
  "version": "1.0.0",
  "description": "template",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "sandcastle": "npm run sandcastle:reviewed",
    "sandcastle:preflight": "tsx .sandcastle/main.mts --preflight",
    "sandcastle:reviewed": "tsx .sandcastle/main.mts",
    "test:sandcastle-workflow": "node --test .sandcastle/workflow-core.test.mjs",
    "typecheck:sandcastle-workflow": "tsc --noEmit --allowJs --checkJs false --module nodenext --moduleResolution nodenext --target es2022 --lib esnext --types node --skipLibCheck .sandcastle/main.mts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/co1smos/flight_search_demo.git"
  },
  "keywords": [],
