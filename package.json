  "bugs": {
    "url": "https://github.com/co1smos/flight_search_demo/issues"
  },
  "homepage": "https://github.com/co1smos/flight_search_demo#readme",
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^26.4.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
